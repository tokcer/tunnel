<?php
// Ambil slug dari URL
$request_path = isset($_GET['slug']) ? trim($_GET['slug'], '/') : '';

if (empty($request_path)) {
    if (file_exists('home.php')) { include('home.php'); }
    else { echo "<h1>404 Not Found</h1>"; }
    exit();
}

$file1 = "list1.txt";
$file2 = "list2.txt";
$filePelengkap = "pelengkap.txt";

if (!file_exists($file1) || !file_exists($file2)) {
    echo "<h1>404 Not Found</h1>";
    exit();
}

$list1 = file($file1, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
$list2 = file($file2, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
$pelengkap = file_exists($filePelengkap) ? file($filePelengkap, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) : [];

$target_string = strtolower($request_path);
$matched_index = -1;
$brand_A = "";
$brand_B = "";

foreach ($list1 as $index => $item) {
    $bA = strtolower(trim(str_replace(' ', '-', $list1[$index])));
    $bB = isset($list2[$index]) && !empty(trim($list2[$index])) ? strtolower(trim(str_replace(' ', '-', $list2[$index]))) : '';
    $combined_slug = $bA . ($bB ? '-' . $bB : '');

    // Pencocokan diperluas: bisa via list1, kombinasi, atau langsung via list2
    if ($target_string === $bA || $target_string === $combined_slug || ($bB !== '' && $target_string === $bB)) {
        $matched_index = $index;
        $brand_A = strtoupper(trim($list1[$index]));
        $brand_B = isset($list2[$index]) ? strtoupper(trim($list2[$index])) : '';
        break;
    }
}

if ($matched_index === -1) {
    $index1 = abs(crc32($target_string . "_b1")) % count($list1);
    $index2 = abs(crc32($target_string . "_b2")) % count($list2);
    $matched_index = $index1;
    $brand_A = strtoupper(trim($list1[$index1]));
    $brand_B = strtoupper(trim($list2[$index2]));
}

$selected_pelengkap = "";
if (!empty($pelengkap)) {
    $p_Index = $matched_index % count($pelengkap);
    $selected_pelengkap = trim($pelengkap[$p_Index]);
}

$BRANDS = trim($brand_A . " x " . $brand_B . " " . $selected_pelengkap);
$protocol = isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on' ? 'https' : 'http';
$fullUrl = $protocol . "://" . $_SERVER['HTTP_HOST'] . $_SERVER['REQUEST_URI'];

$slug_A = strtolower(str_replace(' ', '-', trim($brand_A)));
$slug_B = strtolower(str_replace(' ', '-', trim($brand_B)));
$ampUrl = "https://dewatempur.site/kitacoba/" . $slug_A . ($slug_B ? "-" . $slug_B : "");

$kw_A = strtolower($brand_A);
$kw_B = strtolower($brand_B);
$kata_sambung = ["", "login", "link", "daftar", "alternatif", "resmi", "gacor"]; 
$kumpulan_keyword = [];

foreach ($kata_sambung as $kata) {
    if (!empty($kw_A)) { $kumpulan_keyword[] = trim($kw_A . " " . $kata); }
    if (!empty($kw_B)) { $kumpulan_keyword[] = trim($kw_B . " " . $kata); }
}
$meta_keywords = implode(", ", $kumpulan_keyword);

// Panggil file template HTML panjang di bawah sini
include('template.php');
exit();
?>
